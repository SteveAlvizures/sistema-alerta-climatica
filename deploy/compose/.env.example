# Run commands from the repository root with --env-file .env.
# Copy root .env.example to .env and configure existing Phase 2 credentials first.
# These are extra Phase 3 options; do not commit real secrets.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8082
FRONTEND_ORIGIN=http://localhost:8082
# Production: set FRONTEND_ORIGIN to the actual HTTPS origin and SQLSERVER_EDITION.
# Existing initialized volume, or an independently restored copy. Never mount
# one SQL data volume in two running SQL Server containers.
PHASE3_SQL_VOLUME=climate-alert-sqlserver-data
SIMULATED_READING_INTERVAL_SECONDS=60

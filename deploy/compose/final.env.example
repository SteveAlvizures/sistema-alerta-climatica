# Copy to .env.final (ignored by Git), supply unique secrets, and combine with root .env.
COMMUNITY_DATABASE_PASSWORD=replace-with-unique-community-password
ALERT_DATABASE_PASSWORD=replace-with-unique-alert-password
SENSOR_SQL_PASSWORD=Replace-With-Unique-Sensor-Password-123!
AUDIT_MONGO_PASSWORD=replace-with-unique-audit-password
AUDIT_MONGO_ROOT_PASSWORD=replace-with-different-audit-root-password
FINAL_VOLUME_PREFIX=climate-final
# First run only: explicitly import legacy communities by HTTP before switching routes.
COMMUNITY_IMPORT_LEGACY=false
FINAL_SIMULATION_INTERVAL_SECONDS=0
# Defaults deliberately retain legacy traffic until migration and reconciliation are complete.
COMMUNITY_ROUTE_CLUSTER=monolith
SENSOR_ROUTE_CLUSTER=monolith
ALERT_ROUTE_CLUSTER=monolith
AUDIT_ROUTE_CLUSTER=monolith

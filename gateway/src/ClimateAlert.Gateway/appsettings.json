{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "ClimateAlert.Gateway": "Information",
      "Microsoft.AspNetCore": "None",
      "Microsoft.IdentityModel": "None",
      "System.Net.Http.HttpClient": "None",
      "Yarp.ReverseProxy": "None"
    }
  },
  "AllowedHosts": "*",
  "Gateway": { "AllowedOrigins": [] },
  "ReverseProxy": {
    "Routes": {
      "community-sensors": { "ClusterId": "monolith", "Order": -20, "Match": { "Path": "/api/communities/{communityId}/sensors/{**remainder}" } },
      "community-alerts": { "ClusterId": "monolith", "Order": -20, "Match": { "Path": "/api/communities/{communityId}/alerts/{**remainder}" } },
      "auth": { "ClusterId": "monolith", "Match": { "Path": "/api/auth/{**remainder}" } },
      "users": { "ClusterId": "monolith", "Match": { "Path": "/api/users/{**remainder}" } },
      "communities": { "ClusterId": "monolith", "Match": { "Path": "/api/communities/{**remainder}" } },
      "sensors": { "ClusterId": "monolith", "Match": { "Path": "/api/sensors/{**remainder}" } },
      "sensor-readings": { "ClusterId": "monolith", "Match": { "Path": "/api/sensor-readings/{**remainder}" } },
      "alerts": { "ClusterId": "monolith", "Match": { "Path": "/api/alerts/{**remainder}" } },
      "alert-rules": { "ClusterId": "monolith", "Match": { "Path": "/api/alert-rules/{**remainder}" } },
      "events": { "ClusterId": "monolith", "Match": { "Path": "/api/events/{**remainder}" } },
      "audit-actions": { "ClusterId": "monolith", "Match": { "Path": "/api/audit-actions/{**remainder}" } },
      "dashboard": { "ClusterId": "monolith", "Match": { "Path": "/api/dashboard" } },
      "reports-reserved": { "ClusterId": "monolith", "Match": { "Path": "/api/reports/{**remainder}" } },
      "api-fallback": { "ClusterId": "monolith", "Order": 100, "Match": { "Path": "/api/{**remainder}" } }
    },
    "Clusters": {
      "monolith": {
        "HttpRequest": { "ActivityTimeout": "00:00:30", "Version": "1.1", "VersionPolicy": "RequestVersionOrLower" },
        "HttpClient": { "EnableMultipleHttp2Connections": false, "AllowResponseBuffering": false },
        "Destinations": { "backend": { "Address": "http://localhost:5152/" } }
      }
    }
  }
}

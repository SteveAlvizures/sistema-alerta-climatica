{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "None"
    }
  },

  "AllowedHosts": "*",

  "Gateway": {
    "AllowedOrigins": []
  },

  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },

      "users": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/users/{**remainder}"
        }
      },

      "community-sensors": {
        "ClusterId": "sensor",
        "Order": -20,
        "Match": {
          "Path": "/api/communities/{communityId}/sensors/{**remainder}"
        }
      },

      "community-alerts": {
        "ClusterId": "alert",
        "Order": -20,
        "Match": {
          "Path": "/api/communities/{communityId}/alerts/{**remainder}"
        }
      },

      "communities": {
        "ClusterId": "community",
        "Match": {
          "Path": "/api/communities/{**remainder}"
        }
      },

      "sensors": {
        "ClusterId": "sensor",
        "Match": {
          "Path": "/api/sensors/{**remainder}"
        }
      },

      "sensor-readings": {
        "ClusterId": "sensor",
        "Match": {
          "Path": "/api/sensor-readings/{**remainder}"
        }
      },

      "alerts": {
        "ClusterId": "alert",
        "Match": {
          "Path": "/api/alerts/{**remainder}"
        }
      },

      "alert-rules": {
        "ClusterId": "alert",
        "Match": {
          "Path": "/api/alert-rules/{**remainder}"
        }
      },

      "reports": {
        "ClusterId": "report",
        "Match": {
          "Path": "/api/reports/{**remainder}"
        }
      },

      "audit-events": {
        "ClusterId": "audit",
        "Match": {
          "Path": "/api/audit-events/{**remainder}"
        }
      },

      "audit-actions": {
        "ClusterId": "audit",
        "Match": {
          "Path": "/api/audit-actions/{**remainder}"
        }
      },

      "events": {
        "ClusterId": "monolith",
        "Match": {
          "Path": "/api/events/{**remainder}"
        }
      },

      "dashboard": {
        "ClusterId": "monolith",
        "Match": {
          "Path": "/api/dashboard"
        }
      },

      "api-fallback": {
        "ClusterId": "monolith",
        "Order": 100,
        "Match": {
          "Path": "/api/{**remainder}"
        }
      }
    },

    "Clusters": {
      "auth": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:3001/"
          }
        }
      },

      "community": {
        "Destinations": {
          "community-service": {
            "Address": "http://localhost:3002/"
          }
        }
      },

      "alert": {
        "Destinations": {
          "alert-service": {
            "Address": "http://localhost:3003/"
          }
        }
      },

      "sensor": {
        "Destinations": {
          "sensor-service": {
            "Address": "http://localhost:3004/"
          }
        }
      },

      "report": {
        "Destinations": {
          "report-service": {
            "Address": "http://localhost:3005/"
          }
        }
      },

      "audit": {
        "Destinations": {
          "audit-service": {
            "Address": "http://localhost:3006/"
          }
        }
      },

      "monolith": {
        "Destinations": {
          "backend": {
            "Address": "http://localhost:5152/"
          }
        }
      }
    }
  }
}

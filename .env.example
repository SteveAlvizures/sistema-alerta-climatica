# Conexión de la aplicación con SQL Server.
SQLSERVER_CONNECTION_STRING=Server=sqlserver;Database=ClimateAlertDb;User Id=sa;Password=ChangeThisDemoPassword123!;TrustServerCertificate=True

# Nombre de la base de datos del sistema.
SQLSERVER_DATABASE=ClimateAlertDb

# Credenciales demostrativas del contenedor; deben cambiarse en cada entorno.
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=ChangeThisDemoPassword123!
SQLSERVER_PORT=1433

# Configuración demostrativa para firmar y validar tokens JWT.
JWT_KEY=replace-with-a-demo-signing-key-of-at-least-32-characters
JWT_ISSUER=climate-alert-api
JWT_AUDIENCE=climate-alert-client
JWT_EXPIRATION_MINUTES=60

# Usuarios iniciales de demostración. Sustituya las contraseñas en cualquier entorno no académico.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-demo-admin-password
INITIAL_USER_USERNAME=user
INITIAL_USER_PASSWORD=replace-with-a-demo-user-password

# Agrega de forma idempotente el dataset académico de Guatemala.
DEMO_DATA_SEED_ENABLED=true

# Intervalo, en segundos, entre lecturas simuladas.
SIMULATED_READING_INTERVAL_SECONDS=60

# Configuración futura para recibir lecturas de dispositivos físicos.
PHYSICAL_SENSOR_HTTP_ENABLED=false
PHYSICAL_SENSOR_API_KEY=replace-with-a-demo-device-key
MQTT_ENABLED=false
MQTT_BROKER_HOST=mqtt.example.test
MQTT_BROKER_PORT=1883
MQTT_TOPIC=communities/sensors/readings
MQTT_USERNAME=demo-device
MQTT_PASSWORD=replace-with-a-demo-password

{
  "ConnectionStrings": {
    "SensorDatabase": "Server=${SENSOR_DB_HOST},${SENSOR_DB_PORT};Database=${SENSOR_DB_NAME};User Id=${SENSOR_DB_USER};Password=${SENSOR_DB_PASSWORD};TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}"
  },
  "Services": {
    "Community": "${COMMUNITY_SERVICE_URL}",
    "Alert": "${ALERT_SERVICE_URL}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

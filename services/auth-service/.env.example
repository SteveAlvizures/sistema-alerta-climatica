PORT=3000
AUTH_DATABASE_HOST=localhost
AUTH_DATABASE_PORT=5432
AUTH_DATABASE_NAME=climate_auth
AUTH_DATABASE_USER=auth_app
AUTH_DATABASE_PASSWORD=replace-with-a-unique-password
JWT_KEY=replace-with-the-same-signing-secret-as-gateway
JWT_ISSUER=climate-alert-api
JWT_AUDIENCE=climate-alert-client
JWT_EXPIRATION_MINUTES=60
AUTH_INTERNAL_KEY=replace-with-a-shared-internal-secret-at-least-32-characters
AUTH_AUDIT_URL=http://localhost:5152/internal/auth-events

# Optional OAuth: same browser origin for Angular and /api (use the Angular dev proxy).
OAUTH_ENV=local
OAUTH_PUBLIC_ORIGIN=http://localhost:4200
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Production: OAUTH_ENV=production and OAUTH_PUBLIC_ORIGIN=https://vigiarural.site
# Provider callbacks are derived from that origin: /api/auth/callback/google and /github.
